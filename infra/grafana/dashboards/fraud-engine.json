      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fraud_submissions_total{outcome=\"assessed\"}[$__rate_interval])) * 60",
          "legendFormat": "",
          "refId": "A"
