<?xml version="1.0" encoding="UTF-8"?>
<!-- Unit tests: plain console output (following System.out so OutputCaptureExtension sees it), key-values included. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT" follow="true">
      <PatternLayout pattern="%p %c{1} %m %X%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="com.example" level="info"/>
    <Root level="warn">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
